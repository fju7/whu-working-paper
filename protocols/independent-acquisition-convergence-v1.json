    "route_families": ["BROAD", "CITATION", "REGISTRY"]
  },
  "processes": {
    "A": {
      "random_domain": "WHU_IAC_V1_PROCESS_A",
      "route_policy": "LOWEST_OBSERVED_COVERAGE_THEN_ROUTE_ID",
      "stop_policy": "BUDGET_OR_TWO_ZERO_YIELD"
    },
    "B": {
      "random_domain": "WHU_IAC_V1_PROCESS_B",
      "route_policy": "HIGHEST_OBSERVED_NOVELTY_THEN_ROUTE_ID",
      "stop_policy": "BUDGET_OR_FULL_CLASS_COVERAGE_AND_ZERO_YIELD"
    }
  },
  "observable_record_fields": [
    "source_family_id",
    "evidence_class",
    "direction",
    "magnitude_class"
  ],
  "convergence_rule": {
    "id": "CONVERGENCE_FIXED_V1",
    "family_jaccard_min": 0.30,
    "pivotal_jaccard_min": 0.25,
    "evidence_class_coverage_min_each": 0.60,
    "pooled_recent_marginal_yield_max": 0.50,
