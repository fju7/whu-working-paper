  "success_gate": {
    "maximum_false_assurance": 0.15,
    "minimum_assurance_coverage": 0.10,
    "minimum_relative_false_assurance_reduction_vs_best_eligible_baseline": 0.25,
    "baseline_minimum_coverage_for_comparison": 0.10
