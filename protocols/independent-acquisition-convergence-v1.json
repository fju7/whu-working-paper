{
  "schema_version": "1.0",
  "experiment_id": "WHU-INDEPENDENT-ACQUISITION-CONVERGENCE-V1",
  "seed_start": 21001,
  "seed_count": 1600,
  "partition": {
    "domain": "WHU_IAC_V1_PARTITION",
    "holdout_modulus": 5,
    "holdout_remainder": 0
  },
  "generator": {
    "record_count": [16, 28],
    "evidence_class_count": [4, 7],
    "route_count": [6, 9],
    "route_width": [4, 7],
    "route_budget": [2, 5],
    "contribution_values": [-3, -2, -1, 0, 1, 2, 3],
